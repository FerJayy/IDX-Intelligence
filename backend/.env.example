# Copy this file to .env (same folder) and fill in real values. Never commit .env.
#
# From Neon: Dashboard -> your project -> Connect. Neon shows a URL like
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Split it into the three values below. Use the host WITHOUT "-pooler" in its name.
DB_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
DB_USERNAME=USER
DB_PASSWORD=PASSWORD
